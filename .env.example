# ==============================================================================
# AIRA (Autonomous Investment Research Agent) — Backend Environment Configuration
# ==============================================================================

# Flask Core Application Configuration
# Environments: development | production | testing
FLASK_ENV=development
FLASK_APP=run.py
# In production, SECRET_KEY MUST be a random string >= 32 characters
SECRET_KEY=change-this-to-a-secure-random-32-char-min-key-in-prod
PORT=5000
HOST=127.0.0.1

# MySQL Database Configuration (Primary Transactional Data Store)
# Option 1: Direct connection URI (Recommended for cloud/RDS/production)
DATABASE_URL=mysql+pymysql://aira_user:aira_password@localhost:3306/aira_db

# Option 2: Individual connection parameters (Fallback if DATABASE_URL is not set)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aira_db
MYSQL_USER=aira_user
MYSQL_PASSWORD=aira_password

# Authentication (JWT)
# In production, JWT_SECRET_KEY MUST be a unique random secret >= 32 characters
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-32-char-min-key
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=86400

# CORS (Cross-Origin Resource Sharing)
# In production, set explicit comma-separated allowed origin URLs (e.g., https://aira.app,https://admin.aira.app)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting & Abuse Protection
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://

# Security Headers (CSP, HSTS, X-Content-Type-Options, Referrer-Policy, Permissions-Policy)
SECURITY_HEADERS_ENABLED=true

# Supabase Configuration (Vector Memory & Semantic Embeddings)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI (LLM Reasoning & Embeddings)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_LLM_MODEL=gemini/gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
MEMORY_SIMILARITY_THRESHOLD=0.5

# Alerts & Monitoring Configuration
ALERT_PRICE_MOVE_THRESHOLD_PERCENT=5.0
ALERT_PORTFOLIO_GAIN_LOSS_THRESHOLD_PERCENT=10.0
ALERT_MONITORING_ENABLED=true
NOTIFICATION_ENABLED=true

# External Notification Delivery
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER=resend
NOTIFICATION_EMAIL_API_KEY=
NOTIFICATION_EMAIL_FROM=alerts@aira.internal
NOTIFICATION_WEBHOOK_ENABLED=true
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=5.0

# Scheduled Monitoring & Retries
MONITORING_LOCK_TIMEOUT_SECONDS=300.0
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BASE_DELAY_SECONDS=10.0
NOTIFICATION_RETRY_MAX_DELAY_SECONDS=3600.0
