# Flask Application Configuration
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-to-a-secure-random-key-in-production
PORT=5000
HOST=127.0.0.1

# MySQL Database Configuration
# Option 1: Direct connection URI
DATABASE_URL=mysql+pymysql://aira_user:aira_password@localhost:3306/aira_db

# Option 2: Individual connection parameters (used if DATABASE_URL is not set)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aira_db
MYSQL_USER=aira_user
MYSQL_PASSWORD=aira_password

# Future Services (Phase 1 does not require these)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
JWT_SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
